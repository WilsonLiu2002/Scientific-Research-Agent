# Optional: enables OpenAI synthesis and embedding instead of local deterministic fallbacks.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional alternative chat provider. Qwen uses an OpenAI-compatible endpoint.
LLM_PROVIDER=openai
QWEN_API_KEY=
QWEN_MODEL=qwen3.8-27b
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_FEATURES=planning,critic,synthesis,grounding
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1

# Optional: identify yourself to OpenAlex for polite API usage.
OPENALEX_MAILTO=

# Optional: increases Semantic Scholar citation-graph API capacity.
SEMANTIC_SCHOLAR_API_KEY=

# Optional: use "openai" for embeddings when OPENAI_API_KEY is set.
EMBEDDING_PROVIDER=local

# Optional: directory for cached open-access full-text extraction results.
FULLTEXT_CACHE_DIR=.cache/fulltext

# Durable LangGraph state for pausing and resuming human-review sessions.
CHECKPOINT_DB_PATH=.cache/checkpoints/research.sqlite

# Local structured telemetry is enabled by default. Raw prompts and responses are not recorded.
OBSERVABILITY_JSON_LOGS=true
OBSERVABILITY_LOG_LEVEL=INFO
OBSERVABILITY_CAPTURE_CONTENT=false

# Local trace files are redacted and stored outside version control.
LOCAL_TRACE_ENABLED=true
LOCAL_TRACE_DIR=.cache/traces
